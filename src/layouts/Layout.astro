---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CTAWhatsApp from '../components/CTAWhatsApp.astro';

interface Props {
	title: string;
	description?: string;
	showCTA?: boolean;
}

const { title, description = "Anfitrião Piçarras - Gestão Profissional de Imóveis para Temporada no Litoral de Santa Catarina", showCTA = true } = Astro.props;
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '/index.html';
const finalShowCTA = showCTA && !isHome;
---

<!doctype html>
<html lang="pt-BR" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="bg-white text-slate-900 font-sans antialiased selection:bg-orange-600 selection:text-white m-0 p-0 overflow-x-hidden">
		<Header />
		<slot />
		{finalShowCTA && <CTAWhatsApp />}
		<Footer />
	</body>
</html>

<style is:global>
	@tailwind base;
	@tailwind components;
	@tailwind utilities;
</style>
