{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "bun install",
  "buildCommand": "bun run build",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/blog/:slug",
      "destination": "/blog/:slug/",
      "permanent": true
    }
  ]
}
